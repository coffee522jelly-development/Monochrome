{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "asset",
  "description": "Capability for loading assets",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:window:default",
    "core:webview:allow-set-webview-custom-protocols",
    {
      "identifier": "fs:allow-read",
      "allow": ["**"]
    }
  ]
}
